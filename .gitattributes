# 统一换行符，避免 Windows/Linux 协作时整文件 diff
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv  text eol=lf
*.txt  text eol=lf

# Windows 脚本保持 CRLF，否则 cmd 解析会出问题
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.vbs  text eol=crlf

*.png  binary
*.jpg  binary
*.docx binary
*.lnk  binary
